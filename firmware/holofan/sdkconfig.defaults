# HoloFan (ESP32-C2, 2 MB). Our bootloader (with rollback) and partition
# table (partitions.csv: nvs as stock, ota_0 at 0x10000, ota_1, otadata) are
# written once by flash_first.sh; every later update is an OTA in
# maintenance mode. Flash geometry matches the stock image.
CONFIG_IDF_TARGET="esp32c2"
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_60M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Rollback: a new OTA image boots PENDING_VERIFY and keeps itself only if it
# reaches the mesh within 30 s (docs/MAINTENANCE_API.md).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 1 ms ticks: the mesh task polls every 5 ms (ACKs well inside the 500 ms
# ETM retry window). The IDF default is 100 Hz.
CONFIG_FREERTOS_HZ=1000

# Never read or write Wi-Fi settings in NVS: the stock nvs.net80211
# namespace stays untouched (never erase the stock fan's NVS namespaces).
CONFIG_ESP_WIFI_NVS_ENABLED=n
# Left at its default (y) on purpose: CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE.
# ESP-IDF's PHY keeps its RF calibration in NVS namespace "phy" (cal_data,
# cal_mac, cal_version) and rewrites it when the stored data is missing or
# fails its check (esp_phy/src/phy_init.c, release/v5.4). That is the one
# write outside "hlmesh"; this firmware never asks for it. Turning storage
# off would mean a full calibration at every radio start (longer, and a
# bigger current burst: not tried on a fan). The chip's original "phy" data
# is in the wired backup and comes back with restore_stock.sh.

# The app must fit an OTA slot: optimise for size.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Spec 2026-10-07 D9: advertise a 536-byte TCP MSS. The fan's antenna spins
# inside the dome and large Wi-Fi frames are lost first (ping: 1400 B 70 %,
# 1000 B 37 %, 700 B 0 %), so every client sends ~600-byte frames. lwIP's
# own default; Kconfig range 536..1460. 0.9.16 goes lower through the MTU
# (below): 536 was still on the edge of what arrives.
CONFIG_LWIP_TCP_MSS=536

# 0.9.16: in maintenance the fan advertises a 300-byte MSS (MaintIdf.cpp
# lowers the station's MTU to 340; Kconfig takes no MSS below 536). The
# window is Kconfig's smallest, 2440 bytes = 8 such segments, so one window
# fits the Wi-Fi driver's 10 dynamic RX buffers, and the TCP receive
# mailbox holds a window of segments (Kconfig: TCP_WND / MSS + 2 =
# 2440 / 300 + 2 = 10.1), else lwIP drops segments before httpd. Bench
# 2026-11-13: with the 4288-byte window (14 segments of 256) small segments
# were retransmitted 13-18 %; with 2440 the fan took 45-100 KB/s.
CONFIG_LWIP_TCP_WND_DEFAULT=2440
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12

# Spec 2026-10-07 bench (0.8.1): ping 500 B 0 % loss but TCP staging ran at
# 1-3.5 KB/s with 26 s silences. The AP aggregates TCP segments into long
# A-MPDU frames and the rotor's fading antenna loses them whole. With RX
# aggregation off the AP must send single MPDUs (no Block Ack session for
# our receive side). Kconfig: ESP_WIFI_RX_BA_WIN depends on this option, so
# it disappears with it.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# Bench 2026-10-07 (0.8.5): during an upload session free heap fell to ~3 KB
# (idle 23 KB) and Wi-Fi RX starved: the fan stayed associated but deaf until
# the session ended. A-MPDU RX is off, so fewer static RX buffers are needed
# (each ~1.6 KB, allocated for good at esp_wifi_init); the dynamic limit caps
# a burst (must be >= the static count, Kconfig help).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10

# 0.9.18: task stacks cut to what the bench shows they need plus 1.5 KB or
# more (mcu, mesh and httpd 6144 -> 4608, upload 4096 -> 3584 in the code;
# mDNS 4096 -> 3072 here; it used 1.0 KB). Bench 2026-11-13: the lowest free
# heap during a clip upload rose from about 2 KB to about 9 KB.
CONFIG_MDNS_TASK_STACK_SIZE=3072
