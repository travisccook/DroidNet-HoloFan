#!/bin/sh
# Pre-commit hook: refuse a commit that stages private data (CLAUDE.md,
# "Private data"). tools/install_hooks.sh makes git use this directory.
# To run the same check by hand: python3 tools/check_private.py --staged
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
exec python3 tools/check_private.py --staged
