# HoloFan (ESP32-C2, 2 MB). Our bootloader (with rollback) and partition
# table (partitions.csv: nvs as stock, ota_0 at 0x10000, ota_1, otadata) are
# written once by flash_first.sh; every later update is an OTA in
# maintenance mode. Flash geometry matches the stock image.
CONFIG_IDF_TARGET="esp32c2"
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_60M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Rollback: a new OTA image boots PENDING_VERIFY and keeps itself only if it
# reaches the mesh within 30 s (docs/MAINTENANCE_API.md).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 1 ms ticks: the mesh task polls every 5 ms (ACKs well inside the 500 ms
# ETM retry window). The IDF default is 100 Hz.
CONFIG_FREERTOS_HZ=1000

# Never read or write Wi-Fi settings in NVS: the stock nvs.net80211
# namespace stays untouched (never erase the stock fan's NVS namespaces).
CONFIG_ESP_WIFI_NVS_ENABLED=n

# The app must fit an OTA slot: optimise for size.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Spec 2026-10-07 D9: advertise a 536-byte TCP MSS. The fan's antenna spins
# inside the dome and large Wi-Fi frames are lost first (ping: 1400 B 70 %,
# 1000 B 37 %, 700 B 0 %), so every client sends ~600-byte frames. lwIP's
# own default; Kconfig range 536..1460.
CONFIG_LWIP_TCP_MSS=536

# The TCP receive mailbox must hold a window of MSS-sized segments (Kconfig:
# TCP_WND / MSS + 2 = 4288 / 536 + 2 = 10), else lwIP drops segments before
# httpd. 0.8.5 cut the window from 5760 to 4288 to bound the heap.
CONFIG_LWIP_TCP_WND_DEFAULT=4288
CONFIG_LWIP_TCP_RECVMBOX_SIZE=10

# Spec 2026-10-07 bench (0.8.1): ping 500 B 0 % loss but TCP staging ran at
# 1-3.5 KB/s with 26 s silences. The AP aggregates TCP segments into long
# A-MPDU frames and the rotor's fading antenna loses them whole. With RX
# aggregation off the AP must send single MPDUs (no Block Ack session for
# our receive side). Kconfig: ESP_WIFI_RX_BA_WIN depends on this option, so
# it disappears with it.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# Bench 2026-10-07 (0.8.5): during an upload session free heap fell to ~3 KB
# (idle 23 KB) and Wi-Fi RX starved: the fan stayed associated but deaf until
# the session ended. A-MPDU RX is off, so fewer static RX buffers are needed
# (each ~1.6 KB, allocated for good at esp_wifi_init); the dynamic limit caps
# a burst (must be >= the static count, Kconfig help).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10
